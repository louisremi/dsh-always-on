{
  "name": "dsh-download-files",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: replaces the \"Show file location\" buttons with \"Download file\" buttons, for Harnesses running on a remote host (NAS, Docker, server).",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "download"],
  "license": "MIT",
  "author": "louisremi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louisremi/dsh-download-files.git"
  },
  "bugs": { "url": "https://github.com/louisremi/dsh-download-files/issues" },
  "homepage": "https://github.com/louisremi/dsh-download-files#readme",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "download-route.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check download-route.js && node --check client.js",
    "test": "node --test \"test/*.test.js\""
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": { "node": ">=20" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-open-in-app",
        "@deepseek-ai/dsh-client-ui-deliverables",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  }
}
