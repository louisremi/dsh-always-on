{
  "name": "@louisremi/dsh-docker-adapter",
  "version": "0.3.0",
  "description": "DeepSeek Harness plugin for Harnesses running on a remote host (NAS, Docker, server): download buttons instead of \"Show file location\", a \"Show files\" shortcut, and an in-sidebar Monaco file editor.",
  "keywords": [
    "deepseek-harness",
    "docker",
    "download",
    "dsh",
    "dsh-plugin",
    "editor",
    "monaco"
  ],
  "license": "MIT",
  "author": "louisremi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louisremi/dsh-docker-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/louisremi/dsh-docker-adapter/issues"
  },
  "homepage": "https://github.com/louisremi/dsh-docker-adapter#readme",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "download-route.js",
    "save-route.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check download-route.js && node --check save-route.js && node --check client.js",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node e2e/browser.e2e.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-open-in-app",
        "@deepseek-ai/dsh-client-ui-deliverables",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
