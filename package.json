{
  "name": "@louisremi/dsh-always-on",
  "version": "0.3.0",
  "description": "DeepSeek Harness plugin for harnesses running in a container, with no access to your local file system: download buttons instead of \"Show file location\", a \"Show files\" shortcut, and an in-sidebar Monaco file editor, all through the browser.",
  "keywords": [
    "deepseek-harness",
    "container",
    "docker",
    "download",
    "dsh",
    "dsh-plugin",
    "editor",
    "monaco",
    "remote"
  ],
  "license": "MIT",
  "author": "louisremi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louisremi/dsh-always-on.git"
  },
  "bugs": {
    "url": "https://github.com/louisremi/dsh-always-on/issues"
  },
  "homepage": "https://github.com/louisremi/dsh-always-on#readme",
  "type": "module",
  "icon": "./src/assets/icon.svg",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "src",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.client.json",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.client.json --noEmit",
    "prepare": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "test:e2e": "npm run build && node e2e/browser.e2e.mts"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-open-in-app",
        "@deepseek-ai/dsh-client-ui-deliverables",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
